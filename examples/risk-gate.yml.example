# Example: drop this into your repo as .github/risk-gate.yml
version: 1
risk:
  label: "needs-human-review"
  risky_paths:
    - "api/**"
    - "auth/**"
    - "mcp/**"
    - "skills/**"
    - "AGENTS.md"
  risky_patterns:
    - ".*migration.*\\.sql$"
guardrails:
  coverage_floor: 85
  docs_allowed_dirs: ["docs/"]
  skills_isolation: true
plan:
  require_link: true
  plan_paths: ["plans/**", "docs/plans/**", "docs/rfcs/**"]
  exempt_paths: ["docs/**", "*.md"]
  exempt_labels: ["chore", "deps", "dependabot"]
